---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services, site } from '../data/site';
---
<BaseLayout title="Studio Piras" description="Studio Piras, Dottore Commercialista e Revisore Legale. Consulenza fiscale, societaria e finanziaria per decisioni complesse, operazioni straordinarie, gruppi, patrimonio e contenzioso tributario.">
  <section class="home-hero" data-home-hero>
    <img src="/1.JPG" alt="" width="1200" height="800" fetchpriority="high" decoding="async" class="home-hero-image" />
    <div class="home-hero-overlay" aria-hidden="true"></div>
    <div class="shell home-hero-content">
      <div class="home-hero-copy">
        <h1 class="home-hero-title">{site.claim}</h1>
        <div class="home-hero-body">
          <p>Da oltre trent’anni affianchiamo imprenditori, società e gruppi nelle decisioni fiscali, societarie e finanziarie che richiedono esperienza, visione d’insieme e capacità di valutarne le conseguenze nel tempo.</p>
          <p>Dalla gestione ordinaria alle operazioni straordinarie, dalla riorganizzazione dei gruppi alla pianificazione patrimoniale e successoria, fino al contenzioso tributario: lo Studio Piras interviene dove competenza tecnica e strategia devono procedere insieme.</p>
        </div>
        <a href="/contatti/" class="home-hero-cta">Contatta lo Studio</a>
      </div>
    </div>
  </section>

  <section class="rule shell py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[.6fr_1.4fr]">
      <p class="eyebrow">Lo Studio</p>
      <div class="prose-width body-copy space-y-5">
        <p>Dal 1993 lo Studio Piras affianca imprese, imprenditori e professionisti nella gestione delle questioni fiscali, societarie e finanziarie e nelle operazioni che richiedono una valutazione integrata di più profili.</p>
        <p>L’esperienza maturata nel tempo ha consolidato un metodo fondato sull’analisi del problema nella sua interezza, sull’indipendenza di giudizio e sulla chiarezza delle soluzioni proposte.</p>
        <p>Il rapporto con il cliente resta diretto e personale, anche quando la complessità dell’incarico richiede il coordinamento con competenze legali, notarili o specialistiche.</p>
        <p><a href="/studio/">Conosci lo Studio e Raffaele Piras →</a></p>
      </div>
    </div>
  </section>

  <section class="bg-[var(--navy)] py-20 text-[var(--on-dark)] md:py-28">
    <div class="shell">
      <p class="eyebrow eyebrow-on-dark">Il nostro metodo</p>
      <h2 class="section-title mt-5">Il valore della consulenza nasce dal metodo.</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {[
          ['ANALISI','Comprendere il problema nella sua interezza, ricostruendo fatti, obiettivi, vincoli e conseguenze.'],
          ['STRATEGIA','Confrontare le alternative, misurare rischi e benefici e individuare la soluzione più coerente.'],
          ['ESECUZIONE','Tradurre la scelta in atti, numeri, adempimenti e coordinamento operativo, accompagnandone l’attuazione.']
        ].map(([t,x]) => (
          <div class="border-t border-white/30 pt-6"><h3 class="method-phase-title">{t}</h3><p class="mt-4 method-phase-copy">{x}</p></div>
        ))}
      </div>
      <p class="lead mt-14 max-w-4xl">Le soluzioni tecnicamente corrette possono essere più di una. Il nostro compito è aiutare il cliente a comprendere quale sia la più adatta alla sua situazione e accompagnarlo nella sua concreta realizzazione.</p>
    </div>
  </section>

  <section class="shell py-20 md:py-28">
    <p class="eyebrow">Aree di attività</p>
    <h2 class="section-title mt-5">Le decisioni che richiedono una visione d’insieme.</h2>
    <div class="mt-12 grid md:grid-cols-2">
      {services.map((s,i) => (
        <article class="border-t border-[var(--line)] py-8 md:pr-10">
          <p class="text-xs font-semibold tracking-[.06em] text-[var(--muted)]">0{i+1}</p>
          <h3 class="mt-3 text-[1.65rem] leading-[1.2]"><a class="no-underline" href={`/aree-di-attivita/${s.slug}/`}>{s.title}</a></h3>
          <p class="mt-4 max-w-[62ch] leading-[1.65] text-[var(--muted)]">{s.intro}</p>
          <p class="mt-5 text-sm font-semibold"><a href={`/aree-di-attivita/${s.slug}/`}>Approfondisci →</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="rule shell py-20 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[.65fr_1.35fr]">
      <p class="eyebrow">Competenze integrate</p>
      <div class="prose-width">
        <h2 class="section-title">Competenze integrate per operazioni complesse</h2>
        <p class="body-copy mt-6">Le questioni più complesse raramente appartengono a una sola disciplina. Quando l’incarico lo richiede, lo Studio coordina il proprio intervento con professionisti legali, notarili, finanziari e specialistici, mantenendo una visione unitaria dell’operazione e un interlocutore chiaro per il cliente.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    --hero-parallax-y: -40px;
    position: relative;
    isolation: isolate;
    display: grid;
    width: 100%;
    min-height: clamp(650px, 76vh, 760px);
    overflow: hidden;
    background: var(--navy);
  }

  .home-hero-image {
    position: absolute;
    z-index: -3;
    top: -60px;
    right: 0;
    left: 0;
    width: 100%;
    height: calc(100% + 120px);
    object-fit: cover;
    object-position: 50% 46%;
    transform: translate3d(0, var(--hero-parallax-y), 0);
    will-change: transform;
  }

  .home-hero-overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(13, 31, 42, .66) 0%,
      rgba(13, 31, 42, .56) 42%,
      rgba(13, 31, 42, .43) 72%,
      rgba(13, 31, 42, .38) 100%
    );
  }

  .home-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: inherit;
    align-items: center;
    padding-block: clamp(4.5rem, 9vh, 6.5rem);
  }

  .home-hero-copy {
    width: 100%;
    max-width: 900px;
    color: var(--on-dark);
  }

  .home-hero-title {
    max-width: none;
    color: var(--on-dark);
    font-size: clamp(2.625rem, 3.5vw, 3rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -.025em;
  }

  .home-hero-body {
    max-width: 700px;
    margin-top: 2.15rem;
    color: var(--on-dark);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .home-hero-body p + p {
    margin-top: 1.15em;
  }

  .home-hero-cta {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    margin-top: 2.15rem;
    padding: .82rem 1.15rem;
    border: 1px solid rgba(247, 244, 237, .9);
    border-radius: 2px;
    color: var(--on-dark);
    background: rgba(19, 38, 51, .08);
    font-family: var(--font-body);
    font-size: .95rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .home-hero-cta:hover,
  .home-hero-cta:focus-visible {
    border-color: var(--ivory);
    background: var(--ivory);
    color: var(--navy);
  }

  .method-phase-title {
    color: var(--on-dark);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: .015em;
  }

  .method-phase-copy {
    max-width: 36ch;
    color: var(--on-dark-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  @media (min-width: 900px) {
    .home-hero-title {
      white-space: nowrap;
    }
  }

  @media (min-width: 1024px) {
    .home-hero-copy {
      padding-right: 1rem;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .home-hero {
      min-height: 700px;
    }

    .home-hero-image {
      top: 0;
      height: 100%;
      object-position: 50% 45%;
      transform: none !important;
      will-change: auto;
    }

    .home-hero-overlay {
      background: linear-gradient(
        90deg,
        rgba(13, 31, 42, .67) 0%,
        rgba(13, 31, 42, .56) 62%,
        rgba(13, 31, 42, .44) 100%
      );
    }

    .home-hero-body {
      max-width: 650px;
    }
  }

  @media (max-width: 639px) {
    .home-hero {
      min-height: 700px;
    }

    .home-hero-image {
      top: 0;
      height: 100%;
      object-position: 54% 46%;
      transform: none !important;
      will-change: auto;
    }

    .home-hero-overlay {
      background: linear-gradient(
        180deg,
        rgba(13, 31, 42, .61) 0%,
        rgba(13, 31, 42, .64) 52%,
        rgba(13, 31, 42, .58) 100%
      );
    }

    .home-hero-content {
      align-items: center;
      padding-block: 4rem;
    }

    .home-hero-title {
      font-size: clamp(2.15rem, 10vw, 2.5rem);
      line-height: 1.09;
    }

    .home-hero-body {
      margin-top: 1.8rem;
      font-size: 1.0625rem;
      line-height: 1.6;
    }

    .home-hero-cta {
      margin-top: 1.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero {
      --hero-parallax-y: 0px;
    }

    .home-hero-image {
      transform: none !important;
      will-change: auto;
    }
  }
</style>

<script is:inline>
  (() => {
    const hero = document.querySelector('[data-home-hero]');
    if (!hero) return;

    const header = document.querySelector('.site-header');
    const desktop = window.matchMedia('(min-width: 1024px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const totalMovement = 80;
    let active = false;
    let ticking = false;
    let start = 0;
    let distance = 1;

    const measure = () => {
      const rect = hero.getBoundingClientRect();
      const heroTop = window.scrollY + rect.top;
      const headerHeight = header ? header.getBoundingClientRect().height : 0;
      start = Math.max(0, heroTop - headerHeight);
      distance = Math.max(1, rect.height);
    };

    const update = () => {
      ticking = false;
      if (!active || !desktop.matches || reducedMotion.matches) return;

      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
      const offset = (-totalMovement / 2) + (progress * totalMovement);
      hero.style.setProperty('--hero-parallax-y', `${offset.toFixed(2)}px`);
    };

    const requestUpdate = () => {
      if (!active || !desktop.matches || reducedMotion.matches || ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const refresh = () => {
      measure();
      if (!desktop.matches || reducedMotion.matches) {
        hero.style.setProperty('--hero-parallax-y', '0px');
        return;
      }
      requestUpdate();
    };

    const observer = new IntersectionObserver((entries) => {
      active = entries.some((entry) => entry.isIntersecting);
      if (active) requestUpdate();
    }, { rootMargin: '100px 0px' });

    observer.observe(hero);
    measure();
    active = true;
    update();

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', refresh, { passive: true });
    desktop.addEventListener('change', refresh);
    reducedMotion.addEventListener('change', refresh);
  })();
</script>
