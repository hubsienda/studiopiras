---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { services } from '../../data/site';

const indexIntros: Record<string, string> = {
  'consulenza-societaria-fiscale': "L'impatto degli assetti tributari e societari si estende direttamente sull'architettura aziendale, sulla stabilità economico-finanziaria e sulla tutela della sfera patrimoniale dell’imprenditore.",
  'operazioni-straordinarie': "Gli interventi straordinari di riassetto non costituiscono meri adempimenti formali, bensì trasformazioni sostanziali che ridefiniscono gli equilibri societari, l'esposizione ai rischi, l'impatto fiscale, la liquidità e le traiettorie di sviluppo dell'attività.",
  'holding-gruppi-governance': "La creazione di una società capogruppo non rappresenta un traguardo a sé stante, bensì una risorsa che deve adattarsi perfettamente all'assetto aziendale, ai bilanci finanziari e ai traguardi strategici della compagine sociale.",
  'pianificazione-patrimoniale-passaggio-generazionale': 'Ogni intervento su asset aziendali, quote societarie e passaggio generazionale impone scelte ponderate che bilanciano assetti proprietari, governance, equilibrio familiare e sostenibilità tributaria.',
  'finanza-impresa': "L'equilibrio di un intervento sotto il profilo tributario e societario deve trovare immediato riscontro nella sua concretezza economica e nella sostenibilità dei flussi finanziari.",
  'contenzioso-tributario': "Un accertamento tributario impone scelte immediate e ponderate: prima di impostare la linea difensiva è indispensabile valutare la fondatezza dei rilievi, l'entità del rischio e le diverse opzioni definite dalla norma.",
};
---
<BaseLayout title="Aree di attività" description="Le principali aree di attività dello Studio Piras."><section class="shell py-16 md:py-24"><p class="eyebrow">Aree di attività</p><h1 class="display editorial-heading--short mt-6">Questioni diverse. Un'unica visione d'insieme.</h1><p class="lead mt-9 max-w-3xl">Le competenze dello Studio convergono in modo naturale in ciascun processo decisionale. Per tale ragione, ogni mandato viene esaminato integrando architettura societaria, profilo tributario, leve finanziarie, asset patrimoniali e ricadute operative.</p></section><section class="rule shell py-10">{services.map((s,i)=><article class="grid gap-4 border-b border-[var(--line)] py-10 md:grid-cols-[90px_1fr_1fr]"><p class="text-xs font-semibold tracking-[.06em] text-[var(--muted)]">0{i+1}</p><h2 class="text-[1.65rem] font-semibold leading-[1.2]"><a class="no-underline" href={`/aree-di-attivita/${s.slug}/`}>{s.title}</a></h2><div><p class="max-w-[62ch] leading-[1.65] text-[var(--muted)]">{indexIntros[s.slug] ?? s.intro}</p><p class="mt-5 text-sm font-semibold"><a href={`/aree-di-attivita/${s.slug}/`}>Vai all’area →</a></p></div></article>)}</section><section class="shell py-16 md:py-20"><p class="eyebrow">Servizi specialistici</p><h2 class="section-title mt-5">Analisi tecnico-finanziarie e contenzioso bancario</h2><p class="body-copy mt-6 max-w-3xl">Analisi documentali e relazioni tecnico-economiche in materia bancaria, a supporto di incarichi che richiedono la ricostruzione dei rapporti finanziari e la valutazione delle relative implicazioni.</p></section></BaseLayout>
