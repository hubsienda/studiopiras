---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { services } from '../../data/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const { service }=Astro.props;
---
<BaseLayout title={service.title} description={`${service.title}: assistenza dello Studio Piras con una valutazione integrata delle conseguenze.`}><section class="shell py-16 md:py-24"><nav class="sans text-sm text-[var(--muted)]" aria-label="Percorso"><a href="/">Home</a> / <a href="/aree-di-attivita/">Aree di attività</a></nav><p class="eyebrow mt-10">Area di attività</p><h1 class="display mt-6">{service.title}</h1><p class="lead mt-9 max-w-3xl">{service.intro}</p></section><section class="rule shell py-16"><div class="grid gap-12 lg:grid-cols-[.65fr_1.35fr]"><p class="eyebrow">L’intervento dello Studio</p><div class="prose-width body-copy space-y-5">{service.paragraphs.map((p)=><p>{p}</p>)}</div></div></section><section class="bg-[var(--paper)] py-16"><div class="shell grid gap-12 lg:grid-cols-2"><div><p class="eyebrow">Quando interveniamo</p><ul class="mt-7 divide-y divide-[var(--line)] border-t border-[var(--line)]">{service.when.map((x)=><li class="py-4 text-lg">{x}</li>)}</ul></div><div><p class="eyebrow">Come lavoriamo</p><p class="lead mt-7">{service.method}</p></div></div></section><section class="shell py-16"><p class="eyebrow">Approfondimenti</p><p class="body-copy mt-5 max-w-3xl">Gli approfondimenti collegati a quest’area saranno pubblicati quando disponibili. La sezione editoriale privilegia contributi sostanziali e durevoli.</p></section><section class="bg-[var(--navy)] py-16 text-[var(--paper)]"><div class="shell flex flex-col gap-6 md:flex-row md:items-center md:justify-between"><p class="section-title max-w-3xl">Una decisione importante richiede prima di tutto una lettura corretta del problema.</p><a href="/contatti/" class="sans shrink-0">{service.cta} →</a></div></section></BaseLayout>
