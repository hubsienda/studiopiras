---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pubblicazioni } from '../data/articoli';
---

<BaseLayout
  title="Pubblicazioni"
  description="Approfondimenti professionali dello Studio Piras su temi fiscali, societari, patrimoniali e finanziari disponibili per il download."
>
  <section class="shell py-16 md:py-24">
    <p class="eyebrow">Pubblicazioni</p>
    <h1 class="display editorial-heading--short mt-6">Approfondimenti professionali</h1>
    <p class="lead mt-8 max-w-3xl">Analisi dedicate a questioni fiscali, societarie, patrimoniali e finanziarie, disponibili per la consultazione e il download.</p>
  </section>

  <section class="rule shell pb-8 md:pb-12">
    <div class="publication-list">
      {pubblicazioni.map((pubblicazione) => (
        <article class="publication-row">
          <p class="publication-number" aria-hidden="true">{String(pubblicazione.order).padStart(2, '0')}</p>

          <div class="publication-copy">
            <h2 class="publication-title">{pubblicazione.title}</h2>
            <p class="publication-subtitle">{pubblicazione.subtitle}</p>
          </div>

          <div class="publication-actions">
            <p class="publication-meta">{pubblicazione.date} · {pubblicazione.pages} pagine</p>
            <a
              href={pubblicazione.pdf}
              class="editorial-link publication-download"
              download
              aria-label={`Scarica l'approfondimento ${pubblicazione.title}`}
            >Scarica l'approfondimento</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="shell py-10 md:py-14">
    <a href="/approfondimenti/" class="editorial-link">Torna alle Tematiche</a>
  </section>
</BaseLayout>

<style>
  .publication-list {
    width: 100%;
  }

  .publication-row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(14rem, .42fr);
    gap: 2rem;
    align-items: start;
    padding-block: clamp(2.25rem, 4vw, 3.25rem);
    border-bottom: 1px solid var(--line);
  }

  .publication-number {
    margin: .25rem 0 0;
    color: var(--accent);
    font-size: .875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: .08em;
  }

  .publication-title {
    margin: 0;
    color: var(--navy);
    font-size: clamp(1.5rem, 2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.012em;
  }

  .publication-subtitle {
    max-width: 66ch;
    margin: .8rem 0 0;
    color: var(--ink);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .publication-actions {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: .9rem;
  }

  .publication-meta {
    margin: .2rem 0 0;
    color: var(--muted);
    font-size: .875rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .publication-download {
    max-width: 100%;
  }

  @media (max-width: 1023px) {
    .publication-row {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 1.25rem 1.5rem;
    }

    .publication-actions {
      grid-column: 2;
    }
  }

  @media (max-width: 639px) {
    .publication-row {
      display: block;
      padding-block: 2rem;
    }

    .publication-number {
      margin: 0 0 1rem;
    }

    .publication-title {
      font-size: clamp(1.3125rem, 6vw, 1.5rem);
      line-height: 1.22;
    }

    .publication-subtitle {
      margin-top: .7rem;
      font-size: 1rem;
      line-height: 1.55;
    }

    .publication-actions {
      margin-top: 1.15rem;
      gap: .7rem;
    }

    .publication-meta {
      margin-top: 0;
      font-size: .8125rem;
    }
  }
</style>
