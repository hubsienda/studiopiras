---
import { site } from '../data/site';
---
<footer class="site-footer mt-24">
  <div class="shell grid gap-10 py-14 md:grid-cols-3 md:py-16">
    <div>
      <p class="brand-name text-lg">Studio Piras</p>
      <p class="footer-qualification mt-2 text-sm">Dottore Commercialista · Revisore Legale</p>
    </div>
    <div class="text-sm leading-7">
      <p>Via Sicilia, 65 · 09045 Quartu Sant’Elena (CA)</p>
      <p><a href={`tel:${site.phone.replace(/\s/g,'')}`}>{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div class="text-sm leading-7 md:text-right">
      <p>P. IVA {site.vat}</p>
      <p class="footer-legal-links">
        <a href="/privacy/">Privacy</a>
        <span aria-hidden="true">·</span>
        <a href="/cookie/">Cookie</a>
        <span aria-hidden="true">·</span>
        <button type="button" class="footer-preferences-button" data-cookie-preferences-open>Preferenze cookie</button>
      </p>
      <p>© {new Date().getFullYear()} Studio Dottor Raffaele Piras</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid #D8D1C5;
    background: #EFEAE1;
    color: var(--ink);
  }

  .footer-qualification {
    color: var(--navy-soft);
    font-weight: 600;
  }

  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0 .35rem;
  }

  .footer-preferences-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: .07em;
    text-underline-offset: .22em;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .footer-legal-links {
      justify-content: flex-end;
    }
  }
</style>
