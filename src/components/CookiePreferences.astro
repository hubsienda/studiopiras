<dialog class="cookie-preferences" data-cookie-preferences-dialog aria-labelledby="cookie-preferences-title">
  <div class="cookie-preferences-panel">
    <div class="cookie-preferences-header">
      <div>
        <p class="cookie-preferences-kicker">Preferenze cookie</p>
        <h2 id="cookie-preferences-title">Privacy e preferenze</h2>
      </div>
      <button type="button" class="cookie-preferences-close" data-cookie-preferences-close aria-label="Chiudi preferenze cookie">×</button>
    </div>

    <p class="cookie-preferences-intro">
      Attualmente il sito non utilizza cookie o strumenti facoltativi di analisi, marketing o profilazione. Sono attive soltanto funzionalità tecniche necessarie al funzionamento del sito.
    </p>

    <div class="cookie-preferences-category">
      <div>
        <h3>Necessari</h3>
        <p>Necessari al funzionamento del sito e alla memorizzazione delle preferenze espresse.</p>
        <p class="cookie-preferences-note">Nessun servizio analitico, funzionale di terze parti o di marketing è attualmente attivo sul sito.</p>
      </div>
      <button type="button" class="cookie-preferences-switch" role="switch" aria-checked="true" aria-label="Cookie necessari attivi" disabled>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <p class="cookie-preferences-legal">
      <a href="/privacy/">Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href="/cookie/">Cookie Policy</a>
    </p>

    <div class="cookie-preferences-actions">
      <button type="button" class="cookie-preferences-dismiss" data-cookie-preferences-close>Chiudi</button>
    </div>
  </div>
</dialog>

<style>
  .cookie-preferences {
    width: min(680px, calc(100vw - 3rem));
    max-width: 680px;
    max-height: min(720px, calc(100vh - 3rem));
    margin: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: auto;
    background: var(--ivory);
    color: var(--ink);
    box-shadow: 0 20px 55px rgba(19, 38, 51, .18);
    font-family: var(--font-body);
  }

  .cookie-preferences::backdrop {
    background: rgba(19, 38, 51, .28);
  }

  .cookie-preferences-panel {
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .cookie-preferences-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .cookie-preferences-kicker {
    margin: 0 0 .45rem;
    color: var(--muted);
    font-size: .8rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .cookie-preferences h2 {
    margin: 0;
    color: var(--navy);
    font-size: clamp(1.45rem, 2.6vw, 1.7rem);
    line-height: 1.2;
  }

  .cookie-preferences h3 {
    margin: 0;
    color: var(--navy);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .cookie-preferences p {
    margin: 0;
  }

  .cookie-preferences-close,
  .cookie-preferences-dismiss,
  .cookie-preferences-switch {
    font: inherit;
  }

  .cookie-preferences-close {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--navy);
    font-size: 1.55rem;
    line-height: 1;
    cursor: pointer;
  }

  .cookie-preferences-intro {
    margin-top: 1.25rem !important;
    font-size: 1rem;
    line-height: 1.55;
  }

  .cookie-preferences-category {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    margin-top: 1.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .cookie-preferences-category p {
    margin-top: .45rem;
    font-size: .95rem;
    line-height: 1.5;
  }

  .cookie-preferences-note {
    color: var(--muted);
  }

  .cookie-preferences-switch {
    position: relative;
    display: inline-flex;
    width: 52px;
    min-width: 52px;
    height: 44px;
    align-items: center;
    padding: 0 5px;
    border: 1px solid var(--navy-soft);
    border-radius: 999px;
    background: var(--navy);
    cursor: not-allowed;
    opacity: 1;
  }

  .cookie-preferences-switch span {
    display: block;
    width: 22px;
    height: 22px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--ivory);
  }

  .cookie-preferences-legal {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem .55rem;
    margin-top: 1.25rem !important;
    font-size: .95rem;
    line-height: 1.5;
  }

  .cookie-preferences-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  .cookie-preferences-dismiss {
    min-height: 44px;
    padding: .7rem 1rem;
    border: 1px solid var(--navy);
    background: var(--navy);
    color: var(--on-dark);
    font-weight: 600;
    cursor: pointer;
  }

  .cookie-preferences-close:hover,
  .cookie-preferences-close:focus-visible,
  .cookie-preferences-dismiss:hover,
  .cookie-preferences-dismiss:focus-visible {
    border-color: var(--navy-soft);
  }

  @media (max-width: 639px) {
    .cookie-preferences {
      width: calc(100vw - 2rem);
      max-height: calc(100vh - 2rem);
    }

    .cookie-preferences-category {
      grid-template-columns: 1fr auto;
      gap: .9rem;
    }

    .cookie-preferences-actions {
      justify-content: stretch;
    }

    .cookie-preferences-dismiss {
      width: 100%;
    }
  }
</style>

<script is:inline>
  (() => {
    const dialog = document.querySelector('[data-cookie-preferences-dialog]');
    const openers = Array.from(document.querySelectorAll('[data-cookie-preferences-open]'));
    const closers = Array.from(document.querySelectorAll('[data-cookie-preferences-close]'));

    if (!(dialog instanceof HTMLDialogElement) || !openers.length) return;

    let returnFocus = null;

    const openDialog = (trigger) => {
      returnFocus = trigger instanceof HTMLElement ? trigger : null;
      if (!dialog.open) dialog.showModal();
      const closeButton = dialog.querySelector('[data-cookie-preferences-close]');
      if (closeButton instanceof HTMLElement) closeButton.focus();
    };

    const closeDialog = () => {
      if (dialog.open) dialog.close();
    };

    openers.forEach((trigger) => {
      trigger.addEventListener('click', () => openDialog(trigger));
    });

    closers.forEach((trigger) => {
      trigger.addEventListener('click', closeDialog);
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeDialog();
    });

    dialog.addEventListener('close', () => {
      if (returnFocus instanceof HTMLElement) returnFocus.focus();
    });
  })();
</script>
