---
const current = Astro.url.pathname;
const nav = [
  ['/', 'HOME'],
  ['/studio', 'STUDIO'],
  ['/aree-di-attivita', 'AREE'],
  ['/approfondimenti', 'TEMATICHE'],
  ['/contatti', 'CONTATTI']
];
const isCurrent = (href) => href === '/' ? current === '/' : current.startsWith(href);
---
<header class="site-header sticky top-0 z-50 border-b border-[var(--line)] bg-[var(--ivory)]/97 backdrop-blur-sm">
  <div class="shell site-header-inner flex items-center justify-between gap-5">
    <a href="/" class="header-brand no-underline" aria-label="Studio Piras, home">
      <span class="header-brand-name block">Studio Piras</span>
      <span class="header-brand-subtitle sans block">Dottore Commercialista · Revisore Legale</span>
    </a>

    <nav class="hidden lg:block" aria-label="Navigazione principale">
      <ul class="header-nav flex items-center gap-7">
        {nav.map(([href,label]) => (
          <li>
            <a class:list={["header-nav-link", isCurrent(href) && "is-current"]} href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="relative lg:hidden">
      <summary class="header-menu-trigger cursor-pointer list-none">Menu</summary>
      <nav aria-label="Navigazione mobile" class="header-mobile-nav absolute right-0 mt-3 w-64 border border-[var(--line)] bg-[var(--ivory)] p-5 shadow-sm">
        <ul class="space-y-1">
          {nav.map(([href,label]) => (
            <li><a class:list={["header-mobile-link", isCurrent(href) && "is-current"]} href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header-inner {
    min-height: 100px;
  }

  .header-brand {
    flex: 0 1 auto;
    color: var(--navy);
  }

  .header-brand-name {
    font-family: var(--font-brand);
    font-size: clamp(1.78rem, 2.2vw, 2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: .008em;
    text-transform: none;
  }

  .header-brand-subtitle {
    margin-top: .55rem;
    color: var(--navy-soft);
    font-size: .8rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: .055em;
  }

  .header-nav {
    color: var(--navy);
    font-family: var(--font-body);
    font-size: .91rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: .055em;
  }

  .header-nav-link {
    position: relative;
    display: inline-block;
    padding-block: .55rem;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .header-nav-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: .18rem;
    left: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .header-nav-link:hover,
  .header-nav-link:focus-visible,
  .header-nav-link.is-current {
    color: var(--navy-soft);
  }

  .header-nav-link:hover::after,
  .header-nav-link:focus-visible::after,
  .header-nav-link.is-current::after {
    transform: scaleX(1);
  }

  .header-menu-trigger {
    border: 1px solid var(--line);
    color: var(--navy);
    padding: .7rem .9rem;
    font-family: var(--font-body);
    font-size: .9rem;
    font-weight: 600;
  }

  .header-mobile-link {
    display: block;
    min-height: 44px;
    padding: .7rem .25rem;
    color: var(--navy);
    font-family: var(--font-body);
    font-size: .95rem;
    font-weight: 600;
    letter-spacing: .05em;
    text-decoration: none;
  }

  .header-mobile-link.is-current {
    color: var(--navy-soft);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  @media (max-width: 639px) {
    .site-header-inner {
      min-height: 88px;
      gap: .75rem;
    }

    .header-brand-name {
      font-size: 1.58rem;
    }

    .header-brand-subtitle {
      max-width: 215px;
      margin-top: .45rem;
      font-size: .66rem;
      letter-spacing: .045em;
    }
  }
</style>
