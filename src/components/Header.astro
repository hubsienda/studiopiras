---
const current = Astro.url.pathname;
const nav = [['/studio/','Studio'],['/aree-di-attivita/','Aree di attività'],['/approfondimenti/','Approfondimenti'],['/contatti/','Sedi e contatti']];
---
<header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[var(--ivory)]/95 backdrop-blur-sm"><div class="shell flex min-h-20 items-center justify-between gap-6"><a href="/" class="no-underline" aria-label="Studio Piras, home"><span class="brand-name block text-[1.35rem] leading-none">Studio Piras</span><span class="sans mt-2 block text-[.66rem] uppercase tracking-[.12em] text-[var(--muted)]">Dottore Commercialista · Revisore Legale</span></a><nav class="hidden lg:block" aria-label="Navigazione principale"><ul class="sans flex items-center gap-7 text-sm">{nav.map(([href,label]) => <li><a class:list={["no-underline transition-colors hover:text-[var(--navy-soft)] hover:underline",current.startsWith(href)&&"underline"]} href={href}>{label}</a></li>)}</ul></nav><details class="relative lg:hidden"><summary class="sans cursor-pointer list-none border border-[var(--line)] px-4 py-2 text-sm">Menu</summary><nav aria-label="Navigazione mobile" class="absolute right-0 mt-3 w-64 border border-[var(--line)] bg-[var(--ivory)] p-5 shadow-sm"><ul class="sans space-y-4 text-sm">{nav.map(([href,label]) => <li><a href={href}>{label}</a></li>)}</ul></nav></details></div></header>
