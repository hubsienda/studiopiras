---
const current = Astro.url.pathname;
const nav = [['/studio/','Studio'],['/aree-di-attivita/','Aree di attività'],['/approfondimenti/','Approfondimenti'],['/contatti/','Sedi e contatti']];
---
<header class="border-b border-[var(--line)] bg-[var(--ivory)]/95 sticky top-0 z-50 backdrop-blur-sm"><div class="shell flex min-h-20 items-center justify-between gap-6"><a href="/" class="no-underline" aria-label="Studio Piras, home"><span class="block text-xl tracking-[.08em]">STUDIO PIRAS</span><span class="sans text-[.68rem] uppercase tracking-[.13em] text-[var(--muted)]">Dottore Commercialista · Revisore Legale</span></a><nav class="hidden lg:block" aria-label="Navigazione principale"><ul class="sans flex items-center gap-7 text-sm">{nav.map(([href,label]) => <li><a class:list={["no-underline hover:underline",current.startsWith(href)&&"underline"]} href={href}>{label}</a></li>)}</ul></nav><details class="lg:hidden relative"><summary class="sans cursor-pointer list-none border border-[var(--line)] px-4 py-2 text-sm">Menu</summary><nav aria-label="Navigazione mobile" class="absolute right-0 mt-3 w-64 border border-[var(--line)] bg-[var(--paper)] p-5 shadow-xl"><ul class="sans space-y-4 text-sm">{nav.map(([href,label]) => <li><a href={href}>{label}</a></li>)}</ul></nav></details></div></header>
